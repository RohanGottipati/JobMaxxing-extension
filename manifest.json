{
  "manifest_version": 3,
  "name": "JobMaxxing: Job Application Tracker",
  "version": "1.3.0",
  "minimum_chrome_version": "114",
  "description": "Capture job postings, track application status, and save the resume and cover letter you submitted.",
  "permissions": ["storage", "activeTab", "scripting", "alarms", "tabs", "cookies", "sidePanel"],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.myworkdayjobs.com/*",
    "*://*.greenhouse.io/*",
    "*://*.lever.co/*",
    "*://*.ashbyhq.com/*",
    "*://*.dayforcehcm.com/*",
    "*://*.dayforce.com/*",
    "https://*.supabase.co/*",
    "http://localhost:3000/*",
    "https://job-maxxing.vercel.app/*",
    "https://jobmaxxing-sooty.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open JobMaxxing",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.ashbyhq.com/*",
        "*://*.dayforcehcm.com/*",
        "*://*.dayforce.com/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
